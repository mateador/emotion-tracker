# Copy to .env for local development. Never commit the real .env file.
# Vite only embeds variables prefixed with VITE_ into the built bundle.

VITE_API_URL=http://localhost:4000

# From your OneSignal dashboard -> Settings -> Keys & IDs. This one (unlike
# the REST API key in server/.env.example) is safe to expose client-side --
# it's how the Web Push SDK identifies which OneSignal app to register
# against, not a secret credential.
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id
