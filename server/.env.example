# Copy to .env for local development. Never commit the real .env file.

PORT=4000

# --- Database (Neon) ---
# Get this from your Neon project dashboard -> Connection Details.
# @neondatabase/serverless works over HTTP/WebSocket, so a single pooled
# connection string is sufficient here -- no separate direct URL needed
# the way a traditional pg driver + migration tool setup would require.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-to-a-real-random-secret

# --- CORS ---
# Must be the exact deployed Netlify origin in production, not a wildcard.
CORS_ORIGIN=http://localhost:5173

# --- OneSignal (Web Push) ---
# From your OneSignal dashboard -> Settings -> Keys & IDs.
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# --- Reminder scheduling ---
# Shared secret for POST /api/internal/send-reminders -- generate the same
# way as JWT_SECRET. This endpoint is meant to be called by an external
# scheduler (cron-job.org or similar), never by the app's own frontend, so
# it isn't protected by the normal user JWT auth.
INTERNAL_CRON_SECRET=change-me-to-a-real-random-secret
