{
  "name": "emotion-tracker-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.2.1",
    "cors": "2.8.6",
    "@neondatabase/serverless": "1.1.0",
    "ws": "8.21.3",
    "jsonwebtoken": "9.0.3",
    "bcrypt": "6.0.0",
    "zod": "4.4.3",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.12",
    "@types/express": "5.0.6",
    "@types/cors": "2.8.19",
    "@types/jsonwebtoken": "9.0.10",
    "@types/bcrypt": "6.0.0",
    "@types/ws": "8.18.1",
    "@types/node": "22.10.5"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true
  }
}
